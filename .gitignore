# Dépendances
node_modules/

# Builds et artefacts
dist/
# Dossier de construction.
build/
# Cache de Vite.
.vite/
# Rapports de couverture des tests.
coverage/
# Fichiers de compilation incrémentale de TypeScript.
*.tsbuildinfo

# Variables d'environnement (les exemples sont versionnés)
.env
# Toutes les variantes de .env,
.env.*
# sauf le fichier d'exemple.
!.env.example

# Registre des dons (données privées des donateurs)
storage/

# Caches et logs
cache/
# Dossier des journaux.
logs/
# Fichiers journaux.
*.log
# Journaux d'erreur de npm.
npm-debug.log*
# Journaux de débogage de yarn.
yarn-debug.log*
# Journaux d'erreur de yarn.
yarn-error.log*
# Journaux de débogage de pnpm.
pnpm-debug.log*

# Sauvegardes locales
_sauvegarde_avant_optimisation/

# Données LiDAR (fichiers COPC/LAS volumineux)
/pointclouds/
# Le même dossier, dans le backend.
/backend/pointclouds/

# OS et éditeurs
.DS_Store
# Vignettes de Windows.
Thumbs.db
# Réglages de dossier de Windows.
desktop.ini
# Réglages des éditeurs JetBrains.
.idea/
# Réglages de VS Code.
.vscode/

# Python
__pycache__/
# Fichiers Python compilés.
*.pyc
