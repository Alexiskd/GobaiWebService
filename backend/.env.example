# Copier en .env puis adapter.

# Port d'écoute de l'API.
PORT=3001
# Origines autorisées (CORS), séparées par des virgules. Vide = toutes (développement).
CORS_ORIGIN=http://localhost:5173

# Limitation de débit : LIMIT requêtes par fenêtre de TTL secondes et par IP
THROTTLE_TTL_SECONDS=60
# Nombre de requêtes par fenêtre.
THROTTLE_LIMIT=300

# Dons par carte bancaire via Stripe Checkout (clé secrète uniquement côté serveur).
# sk_test_… pour tester, sk_live_… pour recevoir de vrais dons. Vide = dons fermés.
STRIPE_SECRET_KEY=
# Sites vers lesquels un donateur peut revenir après le paiement.
DONATION_SITE_URLS=https://www.gobaispace.com,https://gobai-space.onrender.com

# --- Application Android (Trusted Web Activity) --------------------------------
# Sert /.well-known/assetlinks.json, qui relie le site à l'application Android (sans lui, barre d'adresse visible).
# Identifiant de l'application choisi à la génération du paquet, et empreintes SHA-256 des certificats de signature
# (Play Console → Intégrité de l'application → Signature d'application), séparées par des virgules.
ANDROID_PACKAGE_NAME=com.gobaispace.twa
# Empreintes des certificats de signature.
ANDROID_SHA256_FINGERPRINTS=

# --- Nuages réels de la Terre vus par satellite (Xweather Raster Maps) ---------
# Identifiants du compte Xweather (https://www.xweather.com) : ils restent sur le serveur, ne jamais les commiter.
# Source des nuages réels quand elle est configurée ; sinon les nuages simulés.
XWEATHER_CLIENT_ID=
# Secret du compte Xweather.
XWEATHER_CLIENT_SECRET=
# Couche Raster Maps relayée (satellite par défaut).
XWEATHER_CLOUD_LAYER=satellite

# --- API NASA (api.nasa.gov) ---------------------------------------------------
# Clé personnelle : https://api.nasa.gov (reste côté serveur, ne jamais la commiter). Vide = DEMO_KEY (débit très limité).
NASA_API_KEY=

# --- Terre : couche unique d'imagerie satellite (earth-hd) -----------------------
# Sources sans clé, toujours actives : IGN (France), USGS (États-Unis), Sentinel-2 cloudless (monde), NASA GIBS.
# Délai (ms) avant d'interroger aussi la source suivante quand la préférée tarde.
EARTH_HEDGE_MS=450

# NASA GIBS (fond terrestre sans clé, expérimental)
GIBS_BASE_URL=https://gibs.earthdata.nasa.gov/wmts/epsg3857/best

# Couche « Terre à l'instant T » (earth-live) : satellites géostationnaires, une image toutes les 10 minutes, sans clé.
# Services WMS interrogés par le serveur (GOES et Himawari chez NASA GIBS, Meteosat chez EUMETView).
GIBS_WMS_URL=https://gibs.earthdata.nasa.gov/wms/epsg3857/best/wms.cgi
# Service WMS d'EUMETView, pour Meteosat.
EUMETVIEW_WMS_URL=https://view.eumetsat.int/geoserver/wms

# --- Tuiles de la Lune ---------------------------------------------------------
# NASA Moon Trek (WMTS géographique, sans clé). Toujours proposé, quel que soit le fournisseur de la Terre.
MOON_TILES_BASE_URL=https://trek.nasa.gov/tiles/Moon/EQ
# Cache disque des tuiles de la Lune : chaque tuile est téléchargée une fois chez la NASA puis servie depuis le disque.
MOON_TILE_CACHE_DIR=cache/moon-tiles
# Préchargement de toute la Lune au démarrage, niveaux 0 à N (-1 = aucun). 4 ≈ 1 400 tuiles, 6 ≈ 22 000 tuiles.
# Pour aller plus loin sans démarrer l'API : npm run moon:prefetch -- 6
MOON_PREFETCH_MAX_ZOOM=4
# Nombre de téléchargements simultanés du préchargement.
MOON_PREFETCH_CONCURRENCY=4
# Couleurs naturelles de la Lune (NASA SVS CGI Moon Kit, JPEG 2048×1024). Une version plus grande convertie en JPEG peut
# être servie ailleurs (les fichiers 4k/8k du Moon Kit sont en TIFF, illisible par les navigateurs).
# Miroirs essayés si MOON_COLOR_URL échoue (svs.gsfc.nasa.gov est parfois bloqué) : même carte NASA/LRO, 1024×512.
# Liste séparée par des virgules, vide pour désactiver le secours.
MOON_COLOR_FALLBACK_URLS=https://cdn.jsdelivr.net/gh/mrdoob/three.js@r180/examples/textures/planets/moon_1024.jpg
# Modèle 3D officiel de la Lune (glTF binaire, NASA SVS https://svs.gsfc.nasa.gov/14959) pour la vue d'ensemble.
# Variantes : moon.glb (couleurs seules), Moon_NASA_LRO_8k_Topo.glb (relief, plus lourd).
MOON_MODEL_URL=https://svs.gsfc.nasa.gov/vis/a010000/a014900/a014959/Moon_NASA_LRO_8k_Topo_Small.glb
# Carte des couleurs naturelles de la Lune.
MOON_COLOR_URL=https://svs.gsfc.nasa.gov/vis/a000000/a004700/a004720/lroc_color_2k.jpg

# --- Tuiles de Mercure ---------------------------------------------------------
# NASA Mercury Trek (WMTS géographique, sans clé) : mosaïque MESSENGER MDIS en couleur renforcée (665 m/pixel).
MERCURY_TREK_WMTS_BASE_URL=https://trek.nasa.gov/tiles/Mercury/EQ/Mercury_MESSENGER_MDIS_Basemap_EnhancedColor_Mosaic_Global_665m/1.0.0
# Niveau maximal de cette mosaïque.
MERCURY_TREK_WMTS_MAX_ZOOM=7
# DEM global MESSENGER/USGS 665 m (ArcGIS ImageServer, exportImage à la demande).
MERCURY_TREK_IMAGESERVER_BASE_URL=https://trek.nasa.gov/mercury/arcgis/rest/services
# Niveau maximal du relief.
MERCURY_TREK_TERRAIN_MAX_ZOOM=8
# Fond pré-rendu MESSENGER + relief (cache ArcGIS tiers, non affilié à l'USGS).
MERCURY_QUICKMAP_TILE_URL=https://tiles.arcgis.com/tiles/0xMt0kzpNJRZcyJb/arcgis/rest/services/Mercury_Basemap/MapServer/tile/{z}/{y}/{x}
# Niveau maximal de ce fond.
MERCURY_QUICKMAP_MAX_ZOOM=5
# Mosaïques MESSENGER servies en WMS (ASU Lunaserv, USGS Astrogeology).
MERCURY_LUNASERV_CAPABILITIES_URL=https://wms.im-ldi.com/lunaserv/wms
# Adresse des images de Lunaserv.
MERCURY_LUNASERV_GETMAP_URL=https://wms.im-ldi.com/
# Niveau maximal de Lunaserv.
MERCURY_LUNASERV_MAX_ZOOM=7
# Service de cartes de l'USGS.
MERCURY_USGS_BASE_URL=https://planetarymaps.usgs.gov/cgi-bin/mapserv
# Carte de Mercure de l'USGS.
MERCURY_USGS_MAP=/maps/mercury/mercury_simp_cyl.map
# Niveau maximal de l'USGS.
MERCURY_USGS_MAX_ZOOM=7
# Cache mémoire des tuiles (une semaine de stale-while-revalidate) et plafond de réponse amont.
MERCURY_TILE_CACHE_ENTRIES=1024
# Durée de vie d'une tuile en cache : un jour, en millisecondes.
MERCURY_TILE_CACHE_TTL_MS=86400000
# Taille maximale d'une réponse amont : 8 Mo.
MERCURY_MAX_UPSTREAM_BYTES=8000000

# --- Position de la Lune --------------------------------------------------------
# Orbites : calculées localement par Kepler (src/services/data/kepler-elements.ts), sans JPL Horizons.
# Phases de la Lune (U.S. Naval Observatory, sans clé).
USNO_API_URL=https://aa.usno.navy.mil/api

# --- Noms des villes -----------------------------------------------------------
# GeoJSON complet Natural Earth 1:10m (≈ 19 Mo) : ≈ 7 300 villes, domaine public. Seule la version complète
# contient les noms dans les écritures locales (NAME_JA, NAME_AR…), affichés sur tous les fonds.
CITY_LABELS_SOURCE_URL=https://cdn.jsdelivr.net/gh/nvkelso/natural-earth-vector@v5.1.2/geojson/ne_10m_populated_places.geojson

# --- Frontières des pays -------------------------------------------------------
# Fichier TopoJSON avec un objet `countries` (par défaut : Natural Earth 1:50m via le paquet world-atlas).
# Téléchargé une fois par le backend puis gardé en mémoire. Pour 1:110m (plus léger) : …/countries-110m.json
BORDERS_SOURCE_URL=https://cdn.jsdelivr.net/npm/world-atlas@2.0.2/countries-50m.json

# --- Nuages de points LiDAR -----------------------------------------------------
# Répertoire des fichiers COPC (.copc.laz) ou LAS/LAZ servis par /api/v1/pointclouds.
# Chemin relatif au répertoire de lancement du backend, ou absolu.
# Pour le viewer Potree, placez aussi la sortie de PotreeConverter dans
# <POINTCLOUD_DIR>/potree/<nom exact du fichier LAS ou LAZ>/ (avec cloud.js à la racine).
# Le serveur transmet les octets et les en-têtes géospatiaux; le rendu se fait dans le navigateur.
POINTCLOUD_DIR=pointclouds

# --- Assistant (fenêtre « Claude », API Claude) --------------------------------
# Clé de l'API Claude : https://platform.claude.com/settings/keys — elle reste sur le serveur. Sans clé, la fenêtre
# reste en démonstration.
# ANTHROPIC_API_KEY=sk-ant-...
# Modèle (le plus petit par défaut) et nombre maximal de réponses par jour pour tout le site.
# ASSISTANT_MODEL=claude-haiku-5-5
# ASSISTANT_DAILY_LIMIT=1000

# --- API externes déconnectées -------------------------------------------------
# Hôtes des API externes que le serveur ne doit jamais appeler, séparés par des virgules
# (ex. api.open-meteo.com,photon.komoot.io). Vide = aucune. Voir l'onglet « API » du site.
BLOCKED_API_HOSTS=
# Clé d'administration : permet à l'onglet « API » du site de déconnecter une API sur le serveur,
# pour tous les visiteurs, jusqu'au redémarrage. Vide = la liste du serveur n'est pas modifiable à distance.
API_ADMIN_TOKEN=

# --- Contributions de placement LiDAR ------------------------------------------
# Secret HMAC HS512 des JWT de session et des jetons d'API payants (au moins 32 octets aléatoires).
# Garder la même valeur entre déploiements ; le blueprint Render la génère durablement.
# La session du navigateur est envoyée dans un cookie HttpOnly, Secure en production et SameSite=Lax.
SESSION_SECRET=
# Les comptes, les placements et les votes sont gardés dans PostgreSQL (DATABASE_URL, comme la galerie).
# Sans DATABASE_URL, ils sont gardés en mémoire et perdus au redémarrage ; le journal du serveur le signale.

# --- Boutique des exports payants ---------------------------------------------
# Ce qui est vendu : le modèle 3D complet d'un astre, ses tuiles assemblées, et l'API de calcul d'orbite.
# Le paiement passe par Stripe (STRIPE_SECRET_KEY ci-dessus) ; le jeton d'accès est signé avec SESSION_SECRET.
# Sans l'une des deux, la boutique s'affiche mais les achats sont fermés.
# Prix des exports par astre, en centimes : 1 500 € chacun par défaut.
# La Terre a un tarif distinct de 100 000 € ; ces variables peuvent être remplacées dans Render.
PRICE_BODY_CENTS=
PRICE_EARTH_CENTS=
PRICE_TILES_CENTS=
PRICE_ALL_CENTS=
# Prix d'une heure de calcul d'orbite, par astre (1 000 € par défaut). Le jeton expire au bout des heures payées.
PRICE_ORBIT_HOUR_CENTS=
