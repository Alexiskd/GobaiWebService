{
  "name": "systeme-solaire-api",
  "version": "2.0.0",
  "private": true,
  "description": "API NestJS du système solaire en direct : astres, éphémérides, villes, routes et modèle de tuiles de la Terre",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "openapi:export": "nest build && node dist/modules/openapi-export.js",
    "moon:prefetch": "nest build && node dist/services/scripts/moon-prefetch.js",
    "world-atlas:build": "nest build && node dist/services/scripts/world-atlas-build.js",
    "pointcloud:anchor": "nest build && node dist/services/scripts/pointcloud-anchor.js",
    "dwarf:import": "nest build && node dist/services/scripts/dwarf-planets-import.js",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.2.1",
    "@types/pg": "^8.23.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.43",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
