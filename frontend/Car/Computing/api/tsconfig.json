{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["main.ts", "app.module.ts", "scene/**/*.ts", "tiles/**/*.ts", "donations/**/*.ts", "contributions/**/*.ts"]
}
