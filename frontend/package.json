{
  "name": "systeme-solaire-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "tsx --test \"src/**/*.test.jsx\"",
    "test:contributions": "tsx --test src/contributions/*.test.ts",
    "typecheck:contributions": "tsc -p tsconfig.contributions.json",
    "native:sync": "vite build && cap sync",
    "native:android": "npm run native:sync && cap open android",
    "native:ios": "npm run native:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@loaders.gl/core": "^4.5.4",
    "@loaders.gl/las": "^4.5.4",
    "@mui/material": "^9.5.0",
    "@noble/hashes": "^2.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "blockstore-idb": "^4.0.1",
    "helia": "^7.1.16",
    "laz-perf": "^0.0.7",
    "multiformats": "^14.0.5",
    "potree-core": "^2.0.17",
    "radix-ui": "^1.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^20.14.0",
    "@types/three": "^0.128.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
